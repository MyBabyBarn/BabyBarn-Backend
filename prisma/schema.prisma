enum InventoryScanSessionStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

enum InventoryScanLineAction {
  NO_CHANGE
  ADD
  REMOVE
  SET
}

/// Draft multi-product stock session — scan identifies only; confirm commits ledger.
model InventoryScanSession {
  id            Int                        @id @default(autoincrement())
  publicId      String                     @unique @default(cuid())
  status        InventoryScanSessionStatus @default(DRAFT)
  createdById   Int
  createdBy     User                       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  sessionNote   String?
  location      String?
  confirmedAt   DateTime?
  discardedAt   DateTime?
  lines         InventoryScanSessionLine[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([createdById, status])
  @@index([status, updatedAt])
}

model InventoryScanSessionLine {
  id               Int                     @id @default(autoincrement())
  publicId         String                  @unique @default(cuid())
  sessionId        Int
  session          InventoryScanSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// p:{productId} or v:{variantId} — unique sellable-line key within a session.
  targetKey        String
  barcodeCode      String
  productId        Int
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId Int?
  productVariant   ProductVariant?         @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  /// Identify-only scan counter (never writes ledger by itself).
  scannedCount     Int                     @default(0)
  action           InventoryScanLineAction @default(NO_CHANGE)
  pendingQty       Int                     @default(0)
  expectedOnHand   Int
  expectedAvailable Int
  expectedStockVersion Int                 @default(0)
  reason           String?
  note             String?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([sessionId, targetKey])
  @@index([sessionId])
  @@index([productId])
  @@index([productVariantId])
}

model ProductReview {
