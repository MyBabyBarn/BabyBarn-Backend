// Internal joins use numeric `id`; clients use `publicId` (cuid) only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PROCESSING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MembershipShareUseMode {
  ONE_TIME
  MULTIPLE
}

// Warehouse / carrier pipeline (orthogonal to OrderStatus; do not remove OrderStatus values).
enum OrderFulfillmentStatus {
  NEW_ORDER
  ACCEPTED
  PICKUP_READY
  LABEL_GENERATED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

enum ReturnType {
  STANDARD
  REFURBISHMENT
}

enum ReturnStatus {
  REQUESTED
  ELIGIBILITY_REVIEW
  ELIGIBILITY_REJECTED
  APPROVED
  LABEL_GENERATED
  IN_TRANSIT
  RECEIVED
  UNDER_INSPECTION
  INSPECTION_APPROVED
  INSPECTION_REJECTED
  REJECTED
  CANCELLED
}

enum RefurbEligibilityDecision {
  PASS
  FAIL
  MANUAL_REVIEW
}

enum RefurbConditionGrade {
  A
  B
  C
}

enum ReturnPackageRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  SENT
}

enum OrderItemPricingTier {
  STANDARD
  ACCESS
}

enum StoreCreditTxnType {
  EARNED
  REDEEMED
  ADJUSTED
  HOLD
  RELEASE
}

enum MembershipPaymentType {
  PURCHASE
  RENEWAL
}

enum ProductType {
  NEW
  REFURBISHED
}

enum InventoryLedgerEventType {
  RESERVE
  RELEASE
  COMMIT
  ADJUST
  RESTOCK
  REFUND_RESTORE
}

enum ProductUnitStatus {
  IN_STOCK
  RESERVED
  SOLD
  WITH_CUSTOMER
  RETURNED
  INSPECTION
  REFURBISHING
  QA_HOLD
  AVAILABLE_REFURB
  RETIRED
}

enum RefurbishmentJobStatus {
  RECEIVED
  INSPECTION
  CLEANING
  IRONING
  REPAIR
  IN_PROGRESS
  QA_APPROVED
  LISTED
  CANCELLED
}

enum CancellationReviewStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum AdminNotificationType {
  NEW_ORDER
  RETURN_REQUEST
  LOW_STOCK
  CANCELLATION_REVIEW
  INSPECTION_QUEUED
  ACCESS_EXPIRING
}

enum HomepageCarouselSlideType {
  HERO
  PRODUCT_GRID
  LETTER
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum ProductReviewStatus {
  APPROVED
  REJECTED
}

enum PlatformReviewStatus {
  SUBMITTED
}

enum ShippingProviderLogLevel {
  INFO
  WARN
  ERROR
}

/// Separates customer-portal identities from staff/admin-portal identities.
/// Same email may exist once per scope (dual accounts).
enum PortalScope {
  CUSTOMER
  STAFF
}

model Role {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         Int      @id @default(autoincrement())
  publicId   String   @unique @default(cuid())
  email      String
  /// CUSTOMER = shop portal; STAFF = admin/team portal. Unique with email.
  portalScope PortalScope @default(CUSTOMER)
  password   String
  firstName  String?
  lastName   String?
  phone      String?
  roleId     Int
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  orders                 Order[]
  addresses              Address[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  inventoryAdjustments   InventoryAdjustment[]
  inventoryScanSessions  InventoryScanSession[]
  returnRequests         ReturnRequest[]
  returnPackageRequests  ReturnPackageRequest[]
  storeCreditWallet      StoreCreditWallet?
  refreshTokens          RefreshToken[]
  membershipPayments     MembershipPayment[]
  sharedAccessOrders     Order[] @relation("SharedAccessOrders")
  membershipShareCodes   MembershipShareCode[] @relation("MembershipShareCodes")
  orderItemsPicked       OrderItem[]           @relation("OrderItemPickedBy")
  checkoutIntents      CheckoutIntent[]
  wishlistItems        WishlistItem[]
  wishlistCartMoves    WishlistCartMove[]
  stockAlertSubscriptions StockAlertSubscription[]
  eligibilityReviews ReturnEligibilityQuestionnaire[] @relation("EligibilityReviewedBy")
  refurbInspections  RefurbInspectionRecord[]         @relation("RefurbInspector")
  returnReceivePackages ReturnReceivePackage[]        @relation("ReturnReceivePackages")
  blogPostsCreated   BlogPost[]                       @relation("BlogPostCreatedBy")
  blogPostsUpdated   BlogPost[]                       @relation("BlogPostUpdatedBy")
  productReviews     ProductReview[]
  platformReviews    PlatformReview[]

  stripeCustomerId   String?
  accessNumber       String?   @unique
  babyName           String?
  /// Relative path or URL to the customer's profile photo.
  avatarUrl          String?
  /// Optional date of birth — used for ACCESS birthday credit.
  dateOfBirth        DateTime?
  /// JSON array of "little ones": [{ id, name, birthday, stage }].
  children           Json?
  /// JSON map of notification toggles: { returnReminders, restockAlerts, accessDrops }.
  notificationPrefs  Json?
  membershipShippingAddressJson Json?
  accessRenewalReminderSentAt DateTime?
  accessExpiryDayReminderSentAt DateTime?
  accessExpiredNoticeSentAt   DateTime?
  accessMemberUntil  DateTime?
  emailVerifiedAt    DateTime?
  /// Guest checkout profile — no password login until converted via register.
  isGuest            Boolean  @default(false)
  guestCreatedAt     DateTime?
  convertedAt        DateTime?
  /// True until the post-register Farmhouse Friends intro is skipped or membership is purchased.
  accessOnboardingPending Boolean @default(false)
  /// Bumped on password/email change to invalidate existing JWTs.
  tokenVersion       Int      @default(0)
  /// Set when expired guest PII has been purged (retention policy). Prevents reprocessing.
  guestPurgedAt      DateTime?
  // When false, customer cannot sign in.
  isActive           Boolean  @default(true)
  // JSON array of admin console module slugs; null = all modules (ADMIN_TEAM).
  adminModules       Json?
  /// ADMIN_TEAM only: when true, may open inbox / receive operational alert emails.
  adminNotificationAccess Boolean @default(false)

  adminNotificationReads AdminNotificationRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, portalScope])
  @@index([email])
  @@index([portalScope])
  @@index([roleId])
  @@index([publicId])
  @@index([isActive])
  @@index([accessNumber])
  @@index([isGuest])
}

model MembershipPayment {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      MembershipPaymentType
  amount    Float
  currency  String   @default("usd")
  stripeSessionId String?
  paidAt    DateTime @default(now())
  accessValidUntil DateTime?
  bundledOrders    Order[]

  @@index([userId])
  @@index([paidAt])
  @@index([stripeSessionId])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(cuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  publicId  String    @unique @default(cuid())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

enum AddressType {
  HOME
  BUSINESS
}

model Address {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(cuid())
  userId    Int
  fullName  String?
  company   String?
  addressLine1 String?
  addressLine2 String?
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  phoneNumber String?
  addressType AddressType @default(HOME)
  isDefault Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          Int        @id @default(autoincrement())
  publicId    String     @unique @default(cuid())
  name        String
  slug        String
  description String?
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  isActive    Boolean    @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, name])
  @@unique([parentId, slug])
  @@index([parentId])
}

model Product {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// Short blurb shown near PDP variant filters (refurbished listings).
  shortDescription     String?
  price       Float
  stock         Int @default(0)
  reservedStock Int @default(0)
  /// Optimistic concurrency for simple (non-variant) SKUs — mirrors ProductVariant.stockVersion (WS-A4).
  stockVersion  Int @default(0)
  categoryId  Int
  imageUrl    String?
  sku         String   @unique

  memberPrice          Float?
  compareAtPrice       Float?
  unitPriceAmount      Float?
  unitPriceReference   String?
  fabric               String?
  feel                 String?
  fit                  String?
  care                 String?
  reorderPoint         Int?
  sizeAgeGroup         String?
  ageGroups            String[]    @default([])
  vendor               String?
  /// Warehouse aisle / bin for simple SKUs (variant uses ProductVariant.warehouseLocation).
  warehouseLocation    String?
  tags                 String?
  isDraft              Boolean  @default(false)
  isActiveListing      Boolean  @default(true)
  inventoryModel       String      @default("simple")
  gallery              Json?
  productType          ProductType @default(NEW)

  /// Denormalized from APPROVED, non-deleted ProductReview rows.
  averageRating        Float?
  reviewCount          Int         @default(0)
  /// JSON map of star → count, e.g. {"1":0,"2":1,"3":2,"4":5,"5":10}
  ratingBreakdown      Json?

  category   Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  checkoutIntentLines CheckoutIntentLine[]
  variants   ProductVariant[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryLedgerEvents InventoryLedgerEvent[]
  inventoryScanSessionLines InventoryScanSessionLine[]
  wishlistItems        WishlistItem[]
  wishlistCartMoves    WishlistCartMove[]
  stockAlertSubscriptions StockAlertSubscription[]
  productUnits         ProductUnit[]
  barcodes             ProductBarcode[]
  productReviews       ProductReview[]
  sourceReturnId       Int?
  sourceReturn         ReturnRequest? @relation("RefurbListedFromReturn", fields: [sourceReturnId], references: [id], onDelete: SetNull)
  sourceProductId      Int?
  sourceProduct        Product?  @relation("RefurbFromSource", fields: [sourceProductId], references: [id], onDelete: SetNull)
  refurbChildren       Product[] @relation("RefurbFromSource")
  conditionGrade       RefurbConditionGrade?
  refurbishedAt        DateTime?
  refurbishmentJobsListed RefurbishmentJob[] @relation("RefurbJobListedProduct")
  homepageCarouselCards HomepageCarouselProductCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([publicId])
  @@index([isDraft])
  @@index([productType])
  @@index([sourceReturnId])
  @@index([sourceProductId])
  @@index([ageGroups])
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique @default(cuid())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  combination   Json
  sku           String
  stock         Int @default(0)
  reservedStock Int @default(0)
  stockVersion  Int @default(0)
  priceOverride Float?
  memberPriceOverride Float?
  imageUrl      String?
  sortOrder     Int      @default(0)
  warehouseLocation String?

  inventoryAdjustments InventoryAdjustment[]
  inventoryLedgerEvents InventoryLedgerEvent[]
  inventoryScanSessionLines InventoryScanSessionLine[]
  orderItems           OrderItem[]
  checkoutIntentLines  CheckoutIntentLine[]
  wishlistItems        WishlistItem[]
  stockAlertSubscriptions StockAlertSubscription[]
  productUnits         ProductUnit[]
  barcodes             ProductBarcode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId])
}

/// Permanent catalog identity. Never derived from SKU; lookup joins live product fields.
model ProductBarcode {
  id               Int      @id @default(autoincrement())
  publicId         String   @unique @default(cuid())
  /// Immutable scan value, e.g. BBP-A1B2C3D4. Not the SKU.
  code             String   @unique
  /// p:{productId} or v:{variantId} — unique sellable-line key (avoids NULL unique issues).
  targetKey        String   @unique
  productId        Int
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId Int?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  sentToVendorAt   DateTime?
  aliases          ProductBarcodeAlias[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@index([productVariantId])
}

/// Old BBP codes kept after regenerate-while-sent so vendor labels still resolve.
model ProductBarcodeAlias {
  id               Int            @id @default(autoincrement())
  publicId         String         @unique @default(cuid())
  code             String         @unique
  productBarcodeId Int
  productBarcode   ProductBarcode @relation(fields: [productBarcodeId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([productBarcodeId])
}

enum CheckoutIntentStatus {
  PENDING
  CONSUMED
  EXPIRED
  FAILED
}

/// In-progress checkout (stock/credit held). Becomes an Order only after payment succeeds.
model CheckoutIntent {
  id                      Int                  @id @default(autoincrement())
  publicId                String               @unique @default(cuid())
  userId                  Int
  status                  CheckoutIntentStatus @default(PENDING)
  checkoutSignature       String
  subtotal                Float
  shippingCost            Float                @default(0)
  taxAmount               Float                @default(0)
  storeCreditApplied      Float                @default(0)
  totalAmount             Float
  shippingAddressJson     Json?
  billingAddressJson      Json?
  shippingCarrier         String?
  shippingShipmentId      String?
  selectedRateId          String?
  selectedRateProvider    String?
  selectedRateServiceLevel String?
  selectedRateServiceToken String?
  selectedRateAmount      Float?
  selectedRateCurrency    String?
  selectedRateEstimatedDays Int?
  stripePaymentIntentId   String?              @unique
  orderPublicId           String?              @unique
  expiresAt               DateTime?
  includeAccessMembership Boolean              @default(false)
  accessMembershipAmount  Float                @default(0)
  membershipBabyName      String?
  sharedAccessOwnerId     Int?
  sharedAccessCodeId      Int?
  sharedAccessNumber      String?
  sharedAccessDiscount    Float                @default(0)
  contactEmail            String?
  placedAsGuest           Boolean              @default(false)

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines CheckoutIntentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([checkoutSignature])
  @@index([createdAt])
}

model CheckoutIntentLine {
  id               Int     @id @default(autoincrement())
  checkoutIntentId Int
  productId        Int
  productVariantId Int?
  quantity         Int
  price            Float
  retailUnitPrice  Float?
  memberPriceSnapshot Float?
  pricingTier      OrderItemPricingTier @default(STANDARD)

  checkoutIntent CheckoutIntent @relation(fields: [checkoutIntentId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([checkoutIntentId])
  @@index([productId])
}

model Order {
  id          Int         @id @default(autoincrement())
  publicId    String      @unique @default(cuid())
  /// Customer-facing reference, e.g. BB-000042 (not the API publicId).
  orderNumber String      @unique
  userId      Int
  status      OrderStatus @default(PENDING)
  /// Fulfillment pipeline; null until paid (then ACCEPTED + fulfillmentAcceptedAt).
  fulfillmentStatus    OrderFulfillmentStatus?
  packageDetailsJson   Json?
  manualShippingNotes  String?  @db.Text
  deliveredAt          DateTime?
  fulfillmentAcceptedAt DateTime?
  pickupReadyAt        DateTime?
  labelGeneratedAt     DateTime?
  outboundShippedAt    DateTime?
  totalAmount Float
  shippingCost Float @default(0)
  taxAmount    Float @default(0)
  shippingAddressJson Json?
  billingAddressJson Json?
  shippingCarrier String?
  trackingNumber String?
  // UPS / carrier label PDF or print URL (set by admin).
  shippingLabelUrl String?
  selectedRateId String?
  selectedRateProvider String?
  selectedRateServiceLevel String?
  selectedRateServiceToken String?
  selectedRateAmount Float?
  selectedRateCurrency String?
  selectedRateEstimatedDays Int?
  shippingShipmentId String?
  shippingTransactionId String?
  returnShipmentId String?
  returnLabelUrl String?
  returnTrackingNumber String?
  returnShippingCarrier String?
  returnTransactionId String?
  trackingStatus String?
  trackingStatusDetails String?
  trackingStatusDate DateTime?
  trackingEta DateTime?
  trackingHistoryJson Json?
  paymentStatus            OrderPaymentStatus @default(PAID)
  stripeCheckoutSessionId  String?            @unique
  stripePaymentIntentId    String?            @unique
  /// WS-A3: Stripe refund IDs whose local side effects (restock/credit/ledger) were applied.
  appliedStripeRefundIds   Json?
  storeCreditApplied       Float              @default(0)
  accessMembershipIncluded Boolean            @default(false)
  sharedAccessOwnerId      Int?
  sharedAccessOwner        User?  @relation("SharedAccessOrders", fields: [sharedAccessOwnerId], references: [id], onDelete: SetNull)
  sharedAccessCodeId       Int?
  sharedAccessCode         MembershipShareCode? @relation(fields: [sharedAccessCodeId], references: [id], onDelete: SetNull)
  sharedAccessNumber       String?
  sharedAccessDiscount     Float  @default(0)
  membershipPaymentId      Int?
  membershipPayment        MembershipPayment? @relation(fields: [membershipPaymentId], references: [id], onDelete: SetNull)
  contactEmail             String?
  contactPhone             String?
  placedAsGuest            Boolean              @default(false)
  includeReturnEnvelope    Boolean              @default(false)
  returnEnvelopeUsed       Boolean              @default(false)

  cancellationReviewStatus  CancellationReviewStatus @default(NONE)
  cancellationRequestedAt   DateTime?
  cancellationRequestReason String?
  cancellationReviewNote    String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  returnRequests ReturnRequest[]
  returnPackageRequests ReturnPackageRequest[]
  trackingEvents ShipmentTrackingEvent[]
  pickupListLines PickupListLine[]
  productReviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([fulfillmentStatus])
  @@index([publicId])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([cancellationReviewStatus])
  @@index([sharedAccessOwnerId])
  @@index([sharedAccessCodeId])
}

model MembershipShareCode {
  id         Int                    @id @default(autoincrement())
  publicId   String                 @unique @default(cuid())
  ownerId    Int
  owner      User                   @relation("MembershipShareCodes", fields: [ownerId], references: [id], onDelete: Cascade)
  code       String                 @unique
  noteEmail  String?
  expiresAt  DateTime?
  useMode    MembershipShareUseMode
  revokedAt  DateTime?
  orders     Order[]
  createdAt  DateTime               @default(now())

  @@index([ownerId])
}

model ShipmentTrackingEvent {
  id            Int      @id @default(autoincrement())
  publicId      String   @unique @default(cuid())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source        String   @default("ups")
  statusCode    String?
  description   String?  @db.Text
  location      String?
  raw           Json?
  eventAt       DateTime?
  createdAt     DateTime @default(now())

  @@index([orderId, createdAt])
}

model PickupList {
  id        Int      @id @default(autoincrement())
  publicId String   @unique @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  lines     PickupListLine[]
}

model PickupListLine {
  id           Int        @id @default(autoincrement())
  publicId     String     @unique @default(cuid())
  pickupListId Int
  orderId      Int
  sortOrder    Int        @default(0)
  pickupList   PickupList @relation(fields: [pickupListId], references: [id], onDelete: Cascade)
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([pickupListId, orderId])
  @@index([orderId])
}

/// Singleton id=1 — operational shipping defaults (non-secret flags + JSON blobs).
model ShippingSettings {
  id                       Int      @id @default(1)
  pickupAddressJson        Json?
  defaultPackageJson       Json?
  autoLabelGeneration      Boolean  @default(false)
  manualShippingAllowed    Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  publicId String  @unique @default(cuid())
  orderId   Int
  productId Int
  productVariantId Int?
  quantity  Int
  price     Float
  pricingTier     OrderItemPricingTier @default(STANDARD)
  retailUnitPrice Float?
  memberPriceSnapshot Float?
  pickedQuantity  Int      @default(0)
  pickedAt        DateTime?
  pickedByUserId  Int?
  /// Set when the customer (or admin) cancels this line before shipment.
  cancelledAt          DateTime?
  cancellationReason   String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  pickedBy User? @relation("OrderItemPickedBy", fields: [pickedByUserId], references: [id], onDelete: SetNull)
  returnRequests ReturnRequest[]
  productReviews ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([pickedByUserId])
  @@index([cancelledAt])
}

model ReturnRequest {
  id Int @id @default(autoincrement())
  publicId String @unique @default(cuid())
  submissionPublicId String @default(cuid())
  /// Customer/admin-facing reference, e.g. SRT-000042 / RRT-000042 (not the API publicId).
  returnNumber String? @unique
  userId Int
  orderId Int
  orderItemId Int?
  type ReturnType @default(STANDARD)
  status ReturnStatus @default(REQUESTED)
  quantity Int @default(1)
  /// Units physically received across all packages (may be partial until fully received).
  receivedQuantity Int @default(0)
  /// Units approved for refund/restock after inspection (may be partial).
  acceptedQuantity Int?
  /// Units rejected after inspection (may be partial).
  rejectedQuantity Int?
  reason String?
  /// Legacy shared notes field; prefer customerNotes / adminNotes.
  notes String?
  /// Customer-facing comments submitted with the return line.
  customerNotes String?
  /// Internal warehouse/admin notes (not shown to customer).
  adminNotes String?
  rejectionReason String?
  photoUrlsJson Json?
  /// Inspector evidence photos when units are rejected (shown to customer).
  inspectorPhotoUrlsJson Json?
  /// RESTOCK | DISCARD | REFURB after accept.
  disposition String?
  dispositionQuantity Int?
  /// DAMAGED | DISCARD for rejected units.
  rejectedDisposition String?
  creditAwarded Float @default(0)
  refundAmount Float?
  stripeRefundId String?
  refundedAt DateTime?
  /// e.g. "Visa ····4242" resolved from Stripe at refund time
  refundPaymentMethodLabel String?
  restockedAt DateTime?
  restockedQuantity Int?
  manualCarrier String?
  manualTrackingNumber String?
  manualShippedAt DateTime?
  /// Customer-submitted USPS return shipment (refurb path).
  customerShippingNote String?
  customerShippingPhotoUrl String?
  customerShippingSubmittedAt DateTime?
  /// Default 10-day window for customer to ship refurb return after approval.
  shipByDeadline DateTime?
  /// Admin extended wait — platform tracks status only.
  keepWaitingUntil DateTime?
  inspectionChecklistJson Json?
  returnLabelUrl String?
  returnTrackingNumber String?
  returnShippingCarrier String?
  returnShipmentId String?
  returnTransactionId String?
  labelGeneratedAt DateTime?
  receivedAt DateTime?
  inspectionApprovedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
