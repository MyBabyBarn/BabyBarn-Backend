# Staging only — copy to backend/.env on the AWS staging EC2.
# NEVER use production DATABASE_URL / Stripe live keys / production JWT here.
# See docs/STAGING-AWS.md

DATABASE_URL=postgresql://stg_user:CHANGE_ME@YOUR_STG_RDS_ENDPOINT:5432/babybarn_stg?sslmode=require
JWT_SECRET=stg-change-me-jwt-secret-long-random
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=stg-change-me-refresh-secret-long-random
JWT_REFRESH_EXPIRY=30d
PORT=5000
NODE_ENV=production
APP_ENV=staging

CORS_ORIGIN=https://stg.mybabybarn.com,https://admin.stg.mybabybarn.com
FRONTEND_USER_URLS=https://stg.mybabybarn.com
FRONTEND_ADMIN_URLS=https://admin.stg.mybabybarn.com
STORE_PUBLIC_URL=https://stg.mybabybarn.com
FRONTEND_URL=https://stg.mybabybarn.com
CUSTOMER_FRONTEND_URL=https://stg.mybabybarn.com
ADMIN_FRONTEND_URL=https://admin.stg.mybabybarn.com

# Stripe TEST mode only
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_stg_replace
STRIPE_CONNECT_ACCOUNT_MEMBERSHIP=
STRIPE_CONNECT_ACCOUNT_STORE=

ACCESS_MEMBERSHIP_DAYS=365
REFURBISHED_ENABLED=true
REFURB_STORE_CREDIT_RATE=0.2
LOW_STOCK_THRESHOLD=10
SALES_TAX_RATE=0.06

EMAIL_PROVIDER=auto
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=staging@mybabybarn.com
