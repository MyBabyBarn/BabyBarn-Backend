{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "eCommerce platform backend API",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "build": "prisma generate",
    "start": "node index.js",
    "test": "node --test tests/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node scripts/seed.js",
    "seed": "node scripts/seed.js",
    "seed:homepage-carousel": "node scripts/seed-homepage-carousel.js",
    "seed:homepage-carousel:force": "node scripts/seed-homepage-carousel.js --force",
    "update:homepage-carousel-copy": "node scripts/update-homepage-carousel-client-copy.js",
    "backfill:return-submission-id": "node scripts/backfill-return-submission-public-id.mjs",
    "backfill:return-submission-id:dry": "node scripts/backfill-return-submission-public-id.mjs --dry-run",
    "smoke:phase2": "node scripts/phase2-smoke.mjs",
    "access:reminders": "node scripts/send-access-reminders.mjs",
    "access:reminders:dry": "node scripts/send-access-reminders.mjs --dry-run",
    "purge:old-orders-returns": "node scripts/purge-old-orders-returns.mjs --before=2026-07-09",
    "purge:old-orders-returns:apply": "node scripts/purge-old-orders-returns.mjs --before=2026-07-09 --apply",
    "migrate:simple-variants": "node scripts/migrate-simple-to-variant-matrix.mjs",
    "migrate:simple-variants:dry": "node scripts/migrate-simple-to-variant-matrix.mjs --dry-run",
    "docs:db-schema": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script -o docs/database/schema-full.sql"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babybarn/brand": "file:./packages/brand",
    "@prisma/client": "^5.7.1",
    "@sendgrid/mail": "^8.1.6",
    "archiver": "^8.0.0",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "stripe": "^17.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "^5.7.1",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "qs": "^6.16.1"
  }
}
